+  // 外観の同期(hareMa の patch)。
+  // 拡張の中では RCTKeyWindow() が nil になり、RN の Appearance は init で "light" に固まる。
+  // 開いた後に外観が変わっても、RN への知らせが来ない。
+  // そのため、(1) RCTOverrideAppearancePreference で RN の外観を置く、
+  // (2) 変化の知らせ RCTUserInterfaceStyleDidChangeNotification を自分で投げる、の 2 つを行う。
+  // 更新の口は traitCollectionDidChange の 1 本(iOS 16.4 以降で同じ道を通る)。
+  private func resolvedTraitCollection() -> (UITraitCollection, String) {
+    let candidates: [(UITraitCollection?, String)] = [
+      (view.window?.traitCollection, "window"),
+      (traitCollection, "vc"),
+      (UIScreen.main.traitCollection, "screen"),
+    ]
+    for (trait, source) in candidates {
+      if let trait = trait, trait.userInterfaceStyle != .unspecified {
+        return (trait, source)
+      }
+    }
+    return (UIScreen.main.traitCollection, "screen")
+  }
+  
+  private func syncAppearanceToReactNative(post: Bool) {
+    if isCleanedUp { return }
+    let (trait, source) = resolvedTraitCollection()
+    let scheme = trait.userInterfaceStyle == .dark ? "dark" : "light"
+    RCTOverrideAppearancePreference(scheme)
+    NSLog("[ShareExtension] appearance %@ (%@)", scheme, source)
+    if post {
+      NotificationCenter.default.post(
+        name: NSNotification.Name("RCTUserInterfaceStyleDidChangeNotification"),
+        object: self,
+        userInfo: ["traitCollection": trait]
+      )
+    }
+  }
+  
+  override func viewIsAppearing(_ animated: Bool) {
+    super.viewIsAppearing(animated)
+    // window が付いた後の値で直す
+    syncAppearanceToReactNative(post: true)
+  }
+  
+  override func traitCollectionDidChange(_ previousTraitCollection: UITraitCollection?) {
+    super.traitCollectionDidChange(previousTraitCollection)
+    if previousTraitCollection?.userInterfaceStyle != traitCollection.userInterfaceStyle {
+      syncAppearanceToReactNative(post: true)
+    }
+  }
+  
